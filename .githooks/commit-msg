#!/usr/bin/env bash
# Reject a commit subject that isn't a Conventional Commit — same contract as
# pr-title-lint.yml. Squash-merge normally makes the PR title the subject, but
# local/merge-strategy commits feed git-cliff's per-port CHANGELOGs too, so gate
# them here rather than only at PR time.
set -euo pipefail

subject=$(grep -vE '^[[:space:]]*(#|$)' "$1" | head -n1 || true)

# Git-generated subjects that never reach a changelog group.
case "$subject" in
'Merge '* | 'Revert "'* | 'fixup! '* | 'squash! '* | 'amend! '*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert|security)(\([a-z0-9-]+\))?!?: .+'
if ! printf '%s\n' "$subject" | grep -qE "$pattern"; then
	echo "commit-msg: subject is not a Conventional Commit:" >&2
	echo "  $subject" >&2
	echo "Expected e.g. 'feat(axum): add multi-source mounting' or 'fix: reject unvalidated schema names'." >&2
	echo "Types: feat fix docs style refactor perf test build ci chore revert security (optional (scope), optional ! for breaking)." >&2
	exit 1
fi
