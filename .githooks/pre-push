#!/usr/bin/env bash
# Reject pushing any commit or tag that isn't signed with a valid (good) GPG/SSH signature.
set -euo pipefail

zero=$(printf '%040d' 0)
bad_found=0

while read -r local_ref local_sha remote_ref remote_sha; do
	[ "$local_sha" = "$zero" ] && continue # deleting a ref, nothing to check

	if [[ "$local_ref" == refs/tags/* ]]; then
		if ! git verify-tag "$local_sha" >/dev/null 2>&1; then
			echo "pre-push: tag $local_ref ($local_sha) is not a validly signed annotated tag" >&2
			bad_found=1
		fi
		continue
	fi

	if [ "$remote_sha" = "$zero" ]; then
		range="$local_sha"
	else
		range="$remote_sha..$local_sha"
	fi

	while read -r sha status; do
		case "$status" in
		G | U) ;; # good signature — G trusted, U good but locally-untrusted key (e.g. GitHub's own web-flow key on merge/Dependabot commits)
		*)
			echo "pre-push: commit $sha ($local_ref) is not validly signed (status: $status)" >&2
			bad_found=1
			;;
		esac
	done < <(git rev-list "$range" --pretty="format:%H %G?" | grep -v '^commit ')
done

if [ "$bad_found" -ne 0 ]; then
	echo "pre-push: aborting — every pushed commit and tag must have a valid signature." >&2
	exit 1
fi
