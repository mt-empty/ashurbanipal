{
  "name": "ashurbanipal-node-express",
  "version": "0.4.0",
  "description": "Node.js/Express + node-postgres port of Ashurbanipal (spec/protocol.md)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mt-empty/ashurbanipal.git",
    "directory": "implementations/node-express"
  },
  "homepage": "https://github.com/mt-empty/ashurbanipal/tree/main/implementations/node-express",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src",
    "demo",
    "frontend/dbviewer.html",
    "tsconfig.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "sync-frontend": "node -e \"require('fs').mkdirSync('frontend',{recursive:true});require('fs').copyFileSync('../../frontend/dbviewer.html','frontend/dbviewer.html')\"",
    "pretest": "npm run sync-frontend",
    "prebuild": "npm run sync-frontend",
    "predemo": "npm run sync-frontend",
    "prepack": "npm run sync-frontend",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').mkdirSync('dist/frontend',{recursive:true});require('fs').copyFileSync('frontend/dbviewer.html','dist/frontend/dbviewer.html')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "demo": "tsx demo/main.ts"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "peerDependencies": {
    "mysql2": "^3.23.2",
    "pg": "^8.22.0",
    "sqlite3": "^6.0.1"
  },
  "peerDependenciesMeta": {
    "mysql2": { "optional": true },
    "pg": { "optional": true },
    "sqlite3": { "optional": true }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "mysql2": "^3.23.2",
    "pg": "^8.22.0",
    "sqlite3": "^6.0.1",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
