{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "@playwright/test"]
  },
  "include": [
    "tests/**/*.ts",
    "perf/**/*.ts",
    "coverage/*.d.mts",
    "playwright.config.ts",
    "playwright.showcase.config.ts",
    "playwright.perf.config.ts"
  ]
}
