{
  "$schema_note": "See spec/fixtures/README.md. Source of truth: spec/protocol.md §5.4.2.",
  "cases": [
    {
      "name": "eq-single",
      "table": "orders",
      "conditions": [
        {
          "column": "status",
          "op": "=",
          "value": "completed"
        }
      ],
      "expect": {
        "where": "(\"status\"::text = $1)",
        "values": [
          "completed"
        ]
      }
    },
    {
      "name": "and-pair",
      "table": "orders",
      "conditions": [
        {
          "column": "total_cents",
          "op": ">=",
          "value": "1"
        },
        {
          "logic": "AND",
          "column": "discount_pct",
          "op": "<=",
          "value": "100"
        }
      ],
      "expect": {
        "where": "(\"total_cents\"::text >= $1) AND (\"discount_pct\"::text <= $2)",
        "values": [
          "1",
          "100"
        ]
      }
    },
    {
      "name": "or-pair",
      "table": "orders",
      "conditions": [
        {
          "column": "status",
          "op": "=",
          "value": "completed"
        },
        {
          "logic": "OR",
          "column": "status",
          "op": "=",
          "value": "pending"
        }
      ],
      "expect": {
        "where": "(\"status\"::text = $1) OR (\"status\"::text = $2)",
        "values": [
          "completed",
          "pending"
        ]
      }
    },
    {
      "name": "precedence-and-or",
      "table": "products",
      "conditions": [
        {
          "column": "category",
          "op": "=",
          "value": "electronics"
        },
        {
          "logic": "AND",
          "column": "created_on",
          "op": ">",
          "value": "2016-01-01"
        },
        {
          "logic": "OR",
          "column": "in_stock",
          "op": "=",
          "value": "true"
        }
      ],
      "expect": {
        "where": "(\"category\"::text = $1) AND (\"created_on\"::text > $2) OR (\"in_stock\"::text = $3)",
        "values": [
          "electronics",
          "2016-01-01",
          "true"
        ]
      }
    },
    {
      "name": "not-wraps-fragment",
      "table": "orders",
      "conditions": [
        {
          "not": true,
          "column": "status",
          "op": "=",
          "value": "completed"
        }
      ],
      "expect": {
        "where": "(NOT (\"status\"::text = $1))",
        "values": [
          "completed"
        ]
      }
    },
