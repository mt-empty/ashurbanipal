{
  "$schema_note": "See spec/fixtures/README.md. Source of truth: spec/protocol.md §5.4.2.",
  "tables": {
    "users": {
      "id": {"type": "uuid", "class": "uuid"},
      "email": {"type": "text", "class": "text"},
      "full_name": {"type": "text", "class": "text"},
      "age": {"type": "smallint", "class": "number"},
      "is_active": {"type": "boolean", "class": "boolean"},
      "login_count": {"type": "integer", "class": "number"},
      "metadata": {"type": "jsonb", "class": "json"},
      "last_login_at": {"type": "timestamp with time zone", "class": "temporal"},
      "created_at": {"type": "timestamp with time zone", "class": "temporal"}
    },
    "orders": {
      "id": {"type": "uuid", "class": "uuid"},
      "user_id": {"type": "uuid", "class": "uuid"},
      "status": {"type": "USER-DEFINED", "class": "enum"},
      "total_cents": {"type": "integer", "class": "number"},
      "discount_pct": {"type": "numeric", "class": "number"},
      "tags": {"type": "ARRAY", "class": "array"},
      "line_items": {"type": "jsonb", "class": "json"},
      "created_at": {"type": "timestamp with time zone", "class": "temporal"}
    },
    "products": {
      "id": {"type": "bigint", "class": "number"},
      "sku": {"type": "character varying", "class": "text"},
      "name": {"type": "text", "class": "text"},
      "category": {"type": "USER-DEFINED", "class": "enum"},
      "price": {"type": "numeric", "class": "number"},
      "weight_kg": {"type": "real", "class": "float"},
      "in_stock": {"type": "boolean", "class": "boolean"},
      "description": {"type": "text", "class": "text"},
      "created_on": {"type": "date", "class": "temporal"}
    }
  },
  "cases": [
    {
      "name": "eq-single",
      "table": "orders",
      "conditions": [
        {
          "column": "status",
          "op": "=",
          "value": "completed"
        }
      ],
      "expect": {
        "where": "(\"status\"::text = $1)",
        "values": [
          "completed"
        ]
      }
    },
    {
      "name": "and-pair",
      "table": "orders",
      "conditions": [
        {
          "column": "total_cents",
          "op": ">=",
          "value": "1"
        },
        {
          "logic": "AND",
          "column": "discount_pct",
          "op": "<=",
          "value": "100"
        }
      ],
      "expect": {
        "where": "(\"total_cents\" >= $1::int8) AND (\"discount_pct\" <= $2::numeric)",
        "values": [
          "1",
          "100"
        ]
      }
    },
    {
      "name": "or-pair",
      "table": "orders",
      "conditions": [
        {
          "column": "status",
          "op": "=",
          "value": "completed"
        },
        {
          "logic": "OR",
          "column": "status",
          "op": "=",
          "value": "pending"
        }
      ],
      "expect": {
        "where": "(\"status\"::text = $1) OR (\"status\"::text = $2)",
        "values": [
          "completed",
          "pending"
        ]
      }
    },
    {
      "name": "precedence-and-or",
      "table": "products",
      "conditions": [
        {
          "column": "category",
          "op": "=",
          "value": "electronics"
        },
        {
          "logic": "AND",
          "column": "created_on",
          "op": ">",
          "value": "2016-01-01"
        },
        {
          "logic": "OR",
          "column": "sku",
          "op": "=",
          "value": "TOYS-1001"
        }
      ],
      "expect": {
        "where": "(\"category\"::text = $1) AND (\"created_on\" > $2::date) OR (\"sku\"::text = $3)",
        "values": [
          "electronics",
          "2016-01-01",
          "TOYS-1001"
        ]
      }
    },
