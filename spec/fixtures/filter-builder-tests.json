        {
          "logic": "AND",
          "column": "total_cents",
          "op": "<",
          "value": "999999"
        }
      ],
      "expect": {
        "where": "(\"total_cents\"::text != $1) AND (\"total_cents\"::text > $2) AND (\"total_cents\"::text < $3)",
        "values": [
          "0",
          "1",
          "999999"
        ]
      }
